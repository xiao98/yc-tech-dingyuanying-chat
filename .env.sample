# YC TECH 丁元英 Chat — P3a deployment env sample
# ==================================================================
# Copy to `.env` and fill every value. `deploy.sh` fail-fasts (exit 1)
# if any of the variables under [REQUIRED] is unset or empty.
#
# Provenance per variable group is annotated in [brackets].
# Only DUMMY placeholders here — never commit real secrets.

# ---- [REQUIRED] Upstream YCAPI (LibreChat custom endpoint target) -----
# YCAPI_BASE_URL is what the system-lock-proxy sidecar forwards to.
# LibreChat itself talks to the sidecar (http://system-lock-proxy:8080),
# so this URL is consumed only by the sidecar container.
YCAPI_BASE_URL=https://ycapi.example.com
# Admin token for YCAPI control-plane operations (provisioning / quota).
# Format: opaque string issued by the YCAPI tenant owner.
YCAPI_ADMIN_KEY=<your-ycapi-admin-key>

# ---- [REQUIRED] New-API admin (P2a per-user sub-key provisioning) -----
# Public format: https://newapi.example.com (no trailing slash). The
# provisioning client appends /api/user/, /api/token/, etc.
NEWAPI_ADMIN_BASE_URL=https://newapi.example.com
# Admin bearer token; New-API issues this in its admin panel.
NEWAPI_ADMIN_KEY=<your-newapi-admin-bearer>

# ---- [REQUIRED] WeChat Pay (APIv3) -----------------------------------
# Merchant id from pay.weixin.qq.com. 10-digit numeric string.
WXPAY_MCH_ID=<your-mch-id>
# APIv3 key — 32-byte symmetric key set in 商户平台 → API安全.
# Used for AEAD-AES-256-GCM resource decrypt on webhook bodies.
WXPAY_API_V3_KEY=<your-32-byte-apiv3-key>
# Path inside the api container to the merchant private key (.pem).
# Mount the file via docker-compose volume; do NOT bake into image.
WXPAY_CERT_PATH=/run/secrets/wxpay/apiclient_key.pem

# ---- [REQUIRED] Alipay (open-platform RSA2) --------------------------
# App id from open.alipay.com. 16-digit numeric string.
ALIPAY_APP_ID=<your-alipay-app-id>
# Path inside the api container to the merchant RSA2 private key (.pem).
ALIPAY_PRIVATE_KEY_PATH=/run/secrets/alipay/app_private_key.pem
# Path inside the api container to the Alipay platform public key (.pem).
ALIPAY_PUBLIC_KEY_PATH=/run/secrets/alipay/alipay_public_key.pem

# ---- [REQUIRED] Stripe -----------------------------------------------
# sk_live_* in production, sk_test_* in sandbox. Server-side only.
STRIPE_SECRET_KEY=<your-stripe-secret-key>
# whsec_* — set in Stripe dashboard webhook endpoint config. Used by
# stripe.webhooks.constructEvent for signature verification.
STRIPE_WEBHOOK_SECRET=<your-stripe-webhook-secret>

# ---- [REQUIRED] Database / auth secrets -------------------------------
# In docker-compose this points at the in-cluster mongo service.
MONGO_URI=mongodb://mongo:27017/LibreChat
# JWT signing secret for LibreChat sessions. 32+ random bytes hex/base64.
JWT_SECRET=<your-jwt-secret-32+bytes-random>

# ---- [REQUIRED] Public DNS -------------------------------------------
# Used by deploy.sh to certbot --register and by nginx server_name.
# Must already point at this server's public IP before deploy.sh runs.
DOMAIN=chat.example.com

# ---- [REQUIRED] P2a — sub-key encryption ------------------------------
# 32 raw bytes encoded as 64-char hex. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AES-256-GCM key for encrypting per-user New-API sub-keys at rest.
SUBKEY_ENCRYPTION_KEY=<64-hex-chars-32-bytes>

# ---- [REQUIRED] P2b — system-lock sidecar ----------------------------
# Path inside the system-lock-proxy container to SKILL.md. Mounted via
# docker-compose `services/system-lock-proxy/test/fixtures/skill.md` or
# a dedicated `./skill-md/skill.md`. Must match SHA256 with the persona
# in librechat.yaml modelSpecs.list[0].preset.promptPrefix.
SKILL_MD_PATH=/etc/system-lock-proxy/skill.md
# Where the sidecar forwards the rewritten request. Inside the docker
# network this is set to the same value as YCAPI_BASE_URL above.
UPSTREAM_BASE_URL=https://ycapi.example.com

# ---- [optional] LibreChat upstream — RAG / search ---------------------
# These are not P3a-required. Leave blank to disable.
RAG_PORT=8000
MEILI_MASTER_KEY=
PORT=3080
HOST=0.0.0.0
UID=1000
GID=1000
